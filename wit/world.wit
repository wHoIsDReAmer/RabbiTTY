// Rabbitty plugin ABI (Tier 2). Semver'd; see README.md.
package rabbitty:plugin@0.3.0;

interface types {
    enum capability {
        write-pty,
        read-config,
        notify,
        network,
        filesystem,
    }

    record plugin-info {
        name: string,
        version: string,
        capabilities: list<capability>,
    }

    record command {
        id: string,
        title: string,
    }

    record output-pattern {
        id: string,
        regex: string,
    }

    record number-range {
        min: f64,
        max: f64,
    }

    variant setting-kind {
        text,
        toggle,
        number(number-range),
        select(list<string>),
    }

    // Rendered by the host; values are owned by the host config and read back
    // through `read-config`.
    record setting-field {
        key: string,
        label: string,
        kind: setting-kind,
        default-value: string,
    }

    record contributions {
        commands: list<command>,
        output-patterns: list<output-pattern>,
        settings: list<setting-field>,
    }

    record match-event {
        pane: u64,
        pattern: string,
        line: string,
        // Byte offsets of the match within `line`.
        start: u32,
        end: u32,
    }

    record cwd-event {
        pane: u64,
        path: string,
    }

    record setting-event {
        key: string,
        value: string,
    }

    variant event {
        session-start(u64),
        session-close(u64),
        output-matched(match-event),
        cwd-changed(cwd-event),
        setting-changed(setting-event),
    }
}

interface host {
    write-pty: func(pane: u64, data: list<u8>);
    notify: func(message: string);
    read-config: func(key: string) -> option<string>;
}

world plugin {
    use types.{plugin-info, contributions, event};

    import host;

    // Runs before anything is granted
    export manifest: func() -> plugin-info;

    export init: func() -> result<_, string>;

    // Skipped when the instance has already trapped; it cannot be re-entered.
    export shutdown: func() -> result<_, string>;

    export contributions: func() -> result<contributions, string>;
    export on-event: func(ev: event) -> result<_, string>;
    export run-command: func(id: string) -> result<_, string>;
}
