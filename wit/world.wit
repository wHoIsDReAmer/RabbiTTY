package rabbitty:plugin@0.4.0;

interface types {
    enum capability {
        write-pty,
        read-config,
        notify,
        network,
        filesystem,
        open-url,
    }

    record plugin-info {
        name: string,
        version: string,
        capabilities: list<capability>,
    }

    record command {
        id: string,
        title: string,
        default-key: option<string>,
    }

    record output-pattern {
        id: string,
        regex: string,
        clickable: bool,
    }

    enum menu-context {
        terminal,
        tab,
    }

    record menu-item {
        id: string,
        title: string,
        context: menu-context,
    }

    record status-item {
        id: string,
        text: string,
        tooltip: option<string>,
        command: option<string>,
    }

    record ssh-target {
        host: string,
        port: u16,
        user: string,
        identity-file: option<string>,
    }

    record local-target {
        program: option<string>,
        args: list<string>,
    }

    variant profile-target {
        local(local-target),
        ssh(ssh-target),
    }

    record plugin-profile {
        id: string,
        name: string,
        subtitle: option<string>,
        icon: option<string>,
        target: profile-target,
    }

    record number-range {
        min: f64,
        max: f64,
    }

    variant setting-kind {
        text,
        toggle,
        number(number-range),
        select(list<string>),
    }

    record setting-field {
        key: string,
        label: string,
        kind: setting-kind,
        default-value: string,
    }

    record contributions {
        commands: list<command>,
        output-patterns: list<output-pattern>,
        settings: list<setting-field>,
        status-items: list<status-item>,
        menu-items: list<menu-item>,
    }

    record match-event {
        pane: u64,
        pattern: string,
        line: string,
        start: u32,
        end: u32,
    }

    record cwd-event {
        pane: u64,
        path: string,
    }

    record title-event {
        pane: u64,
        title: string,
    }

    record selection-event {
        pane: u64,
        text: string,
    }

    record menu-event {
        item: string,
        pane: u64,
        selection: option<string>,
    }

    record setting-event {
        key: string,
        value: string,
    }

    variant event {
        session-start(u64),
        session-close(u64),
        output-matched(match-event),
        match-activated(match-event),
        cwd-changed(cwd-event),
        title-changed(title-event),
        pane-focused(u64),
        active-tab-changed(u64),
        selection-changed(selection-event),
        menu-activated(menu-event),
        bell(u64),
        setting-changed(setting-event),
    }
}

interface host {
    write-pty: func(pane: u64, data: list<u8>);
    notify: func(message: string);
    read-config: func(key: string) -> option<string>;
    open-url: func(url: string);
    set-status: func(id: string, text: string);
}

world plugin {
    use types.{plugin-info, contributions, event, plugin-profile};

    import host;

    export manifest: func() -> plugin-info;

    export init: func() -> result<_, string>;

    export shutdown: func() -> result<_, string>;

    export contributions: func() -> result<contributions, string>;
    export on-event: func(ev: event) -> result<_, string>;
    export run-command: func(id: string) -> result<_, string>;
    export list-profiles: func() -> result<list<plugin-profile>, string>;
}
