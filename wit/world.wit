package rabbitty:plugin@0.5.0;

interface types {
    enum capability {
        write-pty,
        read-config,
        read-screen,
        notify,
        network,
        local-ipc,
        control,
        filesystem,
        open-url,
    }

    record plugin-info {
        name: string,
        version: string,
        description: option<string>,
        author: option<string>,
        homepage: option<string>,
        capabilities: list<capability>,
    }

    record command {
        id: string,
        title: string,
        default-key: option<string>,
    }

    record output-pattern {
        id: string,
        regex: string,
        clickable: bool,
    }

    enum menu-context {
        terminal,
        tab,
    }

    record menu-item {
        id: string,
        title: string,
        context: menu-context,
    }

    record status-item {
        id: string,
        text: string,
        tooltip: option<string>,
        command: option<string>,
    }

    record ssh-target {
        host: string,
        port: u16,
        user: string,
        identity-file: option<string>,
    }

    record local-target {
        program: option<string>,
        args: list<string>,
    }

    variant profile-target {
        local(local-target),
        ssh(ssh-target),
    }

    record plugin-profile {
        id: string,
        name: string,
        subtitle: option<string>,
        icon: option<string>,
        target: profile-target,
    }

    record number-range {
        min: f64,
        max: f64,
    }

    variant setting-kind {
        text,
        toggle,
        number(number-range),
        select(list<string>),
    }

    record setting-field {
        key: string,
        label: string,
        kind: setting-kind,
        default-value: string,
    }

    record contributions {
        commands: list<command>,
        output-patterns: list<output-pattern>,
        settings: list<setting-field>,
        status-items: list<status-item>,
        menu-items: list<menu-item>,
    }

    record match-event {
        pane: u64,
        pattern: string,
        line: string,
        start: u32,
        end: u32,
    }

    record cwd-event {
        pane: u64,
        path: string,
    }

    record title-event {
        pane: u64,
        title: string,
    }

    record selection-event {
        pane: u64,
        text: string,
    }

    record menu-event {
        item: string,
        pane: u64,
        selection: option<string>,
    }

    record setting-event {
        key: string,
        value: string,
    }

    record pane-info {
        id: u64,
        tab: u64,
        title: string,
        cwd: option<string>,
        focused: bool,
    }

    record scrollback-chunk {
        pane: u64,
        %from: u32,
        lines: list<string>,
    }

    record io-frame {
        id: u32,
        data: list<u8>,
    }

    record io-closed {
        id: u32,
        reason: option<string>,
    }

    variant event {
        session-start(u64),
        session-close(u64),
        output-matched(match-event),
        match-activated(match-event),
        cwd-changed(cwd-event),
        title-changed(title-event),
        pane-focused(u64),
        active-tab-changed(u64),
        selection-changed(u64),
        menu-activated(menu-event),
        bell(u64),
        setting-changed(setting-event),
        timer(u32),
        panes(list<pane-info>),
        scrollback(scrollback-chunk),
        selection(selection-event),
        connected(u32),
        data(io-frame),
        closed(io-closed),
        tab-opened(u64),
    }

    record pane-write {
        pane: u64,
        data: list<u8>,
    }

    record status-text {
        id: string,
        text: string,
    }

    record timer {
        id: u32,
        after-ms: u64,
        repeat: bool,
    }

    record scrollback-range {
        pane: u64,
        %from: u32,
        count: u32,
    }

    variant query {
        panes,
        scrollback(scrollback-range),
        selection(u64),
    }

    record tcp-target {
        host: string,
        port: u16,
    }

    variant connect-target {
        tcp(tcp-target),
        local(string),
    }

    record connect-request {
        id: u32,
        target: connect-target,
    }

    variant action {
        write-pty(pane-write),
        notify(string),
        open-url(string),
        set-status(status-text),
        schedule(timer),
        cancel-timer(u32),
        open-tab(profile-target),
        focus-pane(u64),
        close-pane(u64),
        query(query),
        connect(connect-request),
        send(io-frame),
        close(u32),
    }
}

interface host {
    read-config: func(key: string) -> option<string>;
}

world plugin {
    use types.{plugin-info, contributions, event, action, plugin-profile};

    import host;

    export manifest: func() -> plugin-info;

    export init: func() -> result<list<action>, string>;

    export shutdown: func() -> result<list<action>, string>;

    export contributions: func() -> result<contributions, string>;
    export on-event: func(ev: event) -> result<list<action>, string>;
    export run-command: func(id: string) -> result<list<action>, string>;
    export list-profiles: func() -> result<list<plugin-profile>, string>;
}
