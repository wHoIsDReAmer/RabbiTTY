// Rabbitty plugin ABI (Tier 2). Semver'd; see README.md.
package rabbitty:plugin@0.1.0;

interface types {
    enum capability {
        write-pty,
        read-config,
        notify,
        network,
        filesystem,
    }

    record plugin-info {
        name: string,
        version: string,
        capabilities: list<capability>,
    }

    record command {
        id: string,
        title: string,
        default-key: option<string>,
    }

    record menu-item {
        id: string,
        label: string,
    }

    record contributions {
        commands: list<command>,
        menu-items: list<menu-item>,
    }

    record line-event {
        pane: u64,
        line: string,
    }

    record cwd-event {
        pane: u64,
        path: string,
    }

    variant event {
        session-start(u64),
        session-close(u64),
        line-output(line-event),
        cwd-changed(cwd-event),
    }
}

interface host {
    write-pty: func(pane: u64, data: list<u8>);
    notify: func(message: string);
    read-config: func(key: string) -> option<string>;
}

world plugin {
    use types.{plugin-info, contributions, event};

    import host;

    export manifest: func() -> plugin-info;
    export init: func();
    // Skipped when the instance has already trapped; it cannot be re-entered.
    export shutdown: func();

    export contributions: func() -> contributions;
    export on-event: func(ev: event);
    export run-command: func(id: string);
}
